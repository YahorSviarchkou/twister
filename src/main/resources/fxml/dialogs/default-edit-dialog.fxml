<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane fx:id="anchorPane" prefHeight="200.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <VBox alignment="TOP_RIGHT" prefHeight="220.0" prefWidth="400.0">
         <children>
            <VBox prefHeight="41.0" prefWidth="330.0">
               <children>
                  <Text fx:id="dialogTitle" strokeType="OUTSIDE" strokeWidth="0.0" text="text" wrappingWidth="323.45941734313965">
                     <font>
                        <Font size="25.0" />
                     </font>
                     <VBox.margin>
                         <Insets bottom="20.0" />
                     </VBox.margin>
                  </Text>
               </children>
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
            </VBox>
            <VBox fx:id="fieldBox" alignment="CENTER_LEFT" prefHeight="98.0" prefWidth="330.0" stylesheets="@../../styles/tab-screen.css">
               <children>
                  <Text strokeType="OUTSIDE" strokeWidth="0.0" text="text">
                     <VBox.margin>
                        <Insets bottom="10.0" />
                     </VBox.margin>
                     <font>
                        <Font size="15.0" />
                     </font>
                  </Text>
                  <TextField fx:id="titleField" prefHeight="26.0" prefWidth="554.0" promptText="Наименование" stylesheets="@../../styles/tab-screen.css" text="text">
                     <VBox.margin>
                        <Insets bottom="20.0" />
                     </VBox.margin>
                  </TextField>
               </children>
            </VBox>
            <VBox alignment="BOTTOM_RIGHT" prefHeight="42.0" prefWidth="330.0">
               <children>
                  <ButtonBar prefHeight="74.0" prefWidth="330.0">
                    <buttons>
                      <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#onCancelAction" text="%cancel.button" />
                        <Button fx:id="saveButton" mnemonicParsing="false" onAction="#onSaveAction" />
                    </buttons>
                  </ButtonBar>
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="20.0" left="35.0" right="35.0" top="20.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>
