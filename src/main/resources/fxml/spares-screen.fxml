<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.twister.ui.screen.SparesScreen">
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
   <children>
      <Text fill="#262628" strokeType="OUTSIDE" strokeWidth="0.0" text="Запчасти">
         <font>
            <Font name="Formular-Medium" size="32.0" />
         </font>
      </Text>
      <VBox prefHeight="384.0" prefWidth="539.0" styleClass="vbox-container" stylesheets="@../styles/spares-screen.css">
         <VBox.margin>
            <Insets top="50.0" />
         </VBox.margin>
         <children>
            <HBox alignment="CENTER" prefHeight="200.0" prefWidth="200.0" spacing="20.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#createSpare" text="Добавить запчасть" />
                  <TextField />
                  <TextField />
               </children>
            </HBox>
            <TableView prefWidth="539.0">
              <columns>
                <TableColumn prefWidth="75.0" text="№" />
                <TableColumn prefWidth="165.0" text="Наименование" />
                  <TableColumn prefWidth="125.0" text="Стоимость" />
              </columns>
            </TableView>
         </children>
      </VBox>
   </children>
</VBox>
