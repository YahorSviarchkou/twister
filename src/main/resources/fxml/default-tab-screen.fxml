<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox prefHeight="604.0" prefWidth="810.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" >
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
   <children>
      <Text fx:id="tabName" fill="#262628" strokeType="OUTSIDE" strokeWidth="0.0">
         <font>
            <Font name="Formular-Medium" size="32.0" />
         </font>
      </Text>
      <VBox maxHeight="1.7976931348623157E308" prefWidth="750.0" styleClass="vbox-container" stylesheets="@../styles/tab-screen.css" VBox.vgrow="ALWAYS">
         <VBox.margin>
            <Insets top="50.0" />
         </VBox.margin>
         <children>
            <HBox alignment="CENTER_LEFT" prefWidth="740.0" spacing="20.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#onCreateEvent" text="%add.button" />
                  <TextField />
                  <TextField />
               </children>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
               <padding>
                  <Insets bottom="10.0" left="5.0" right="5.0" top="10.0" />
               </padding>
            </HBox>
            <TableView fx:id="table" maxHeight="1.7976931348623157E308" prefWidth="729.0" VBox.vgrow="ALWAYS">
              <columns>
              </columns>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </TableView>
         </children>
      </VBox>
   </children>
</VBox>
